<div id="resource-<%= resource.id %>">
    <div class="px-3 py-2 mb-1 bg-white shadow-sm rounded">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                    <%= link_to resource_path(resource), class:'no-decoration' do %>
                        <div class="commune-list">
                            <%= resource.name.titleize %>
                        </div>
                    <% end %>
                <div class="region-list">
                    <%= resource.web_address %>
                </div>
                <div class="region-list">
                    <%= resource.branch.address_concat.titleize %>
                </div>
                <div class="token-resource mt-1">
                    <div class="text-primary">Token:</div>
                    <%= resource.token %>
                </div>

            </div>
            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <div class="date-list">
                        <span><%= format_date_human resource.created_at %></span>
                    </div>
                    <div class="date-list">
                        <span><%= enum_i18n(Resource, :statuses, resource.status )%></span>
                    </div>

                </div>
                <% if policy(resource).edit? %>
                    <div class="btn-group dropstart">
                        <div class="btn btn-link pe-0 ps-3 btn-icon" data-bs-toggle="dropdown" aria-expanded="false">
                            <%= inline_svg_tag('icons/icon_ellipsis.svg', class:'icon-info')%>
                        </div>
                        <ul class="dropdown-menu shadow">
                            <% if policy(resource).edit? %>
                                <li>
                                    <%= link_to edit_resource_path(resource), 
                                            class:'dropdown-item text-success d-flex justify-content-between align-items-center', 
                                            remote:true do %>
                                        <span>Editar</span> <i class="fa-solid fa-pencil"></i>
                                    <% end %>
                                </li>
                            <% end %>
                            <% if policy(resource).destroy? %>
                                <li>
                                    <%= link_to resource_path(resource), 
                                            class:'dropdown-item text-danger d-flex justify-content-between align-items-center', 
                                            data:{confirm:'Estas seguro de eliminar el recurso de API, la perderás permanentemente.'}, 
                                            remote:true, 
                                            method: :delete do %>
                                        <span>Eliminar</span> <i class="fa-solid fa-trash"></i>
                                    <% end %>
                                </li>
                            <% end %>
                        </ul>
                    </div>
                <% end %>
            </div>
        </div>
    </div>
</div>