
<div class="container py-2 mt-3">
  <%= form_with url: paginate_profiles_profiles_path, data: { remote: true }, method: :get  do |f| %>
    <div class="row">
      <div class="form-group col-sm-12 col-md-6 col-lg-3 col-xl-2">
        <%= f.text_field :query, class: 'form-control', placeholder: 'Buscar nombre o correo' %>
      </div>
      <div class="form-group col-sm-12 col-md-6 col-lg-3 col-xl-2">
        <%= f.select :role,
                     User.roles.keys.map { |role| [enum_i18n(User, :roles, role), role] },
                     { include_blank: 'Todos' },
                     class: 'form-control'
        %>
      </div>
      <div class="form-group col-sm-12 col-md-6 col-lg-3 col-xl-2">
        <button type="submit" class="btn btn btn-outline-info w-100 h-100 p-3">
          <i class="bi bi-filter-circle-fill"></i> Filtrar
        </button>
      </div>
    </div>
  <% end %>
</div>