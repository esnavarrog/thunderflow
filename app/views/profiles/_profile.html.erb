<div id="profile-<%= profile.id %>" class="">
    <div class="px-3 py-2 mb-1 bg-white shadow-sm rounded">
        <div class="d-flex justify-content-between align-items-center">
            <%= link_to profile_path(profile), class:'no-decoration' do %>
                <div class="commune-list">
                    <%= profile.name.try(:titleize) %>
                </div>
                <div class="region-list">
                    <%= profile.try(:email) %>
                </div>
                
                <div class="id-list">
                    Id: <%= profile.id %>
                </div>
            <% end %>
            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <div class="date-list">
                        <%= enum_i18n(User, :roles, profile.role) %>
                    </div>
                    <div class="date-list">
                        <span>Creado <%= format_date profile.created_at %></span>
                    </div>
                    <% if profile.confirmed_at.nil? %>
                      <div class="date-list text-danger">
                          <span>No Verificado</span>
                      </div>
                    <% end %>
                    <div class="date-list">
                        <span>Actualizado <%= format_date profile.updated_at %></span>
                    </div>

                </div>
                <div class="btn-group dropstart">
                    <div class="btn btn-link pe-0 ps-3 btn-icon" data-bs-toggle="dropdown" aria-expanded="false">
                        <%= inline_svg_tag('icons/icon_ellipsis.svg', class:'icon-info')%>
                    </div>
                    <ul class="dropdown-menu shadow">
                        <li>
                            <%= link_to profile_path(profile), class:'dropdown-item text-success d-flex justify-content-between align-items-center' do %>
                                <span>Ver</span> <i class="fa-solid fa-chevron-right"></i>
                            <% end %>
                        </li>
                      <li>
                        <% if profile.confirmed_at.nil? %>
                          <%= link_to confirmed_profile_path(profile), class:'dropdown-item text-success d-flex justify-content-between align-items-center' do %>
                            <span>Confirmar usuario</span> <i class="fa-solid fa-check"></i>
                          <% end %>
                        <% end %>
                      </li>
                        <li>
                            <%= link_to profile_path(profile), class:'dropdown-item text-danger d-flex justify-content-between align-items-center', data:{confirm:'Estas seguro de eliminar este perfil? Esta acción es irreversible.'}, method: :delete, remote:true do %>
                                <span>Eliminar</span> <i class="fa-solid fa-trash"></i>
                            <% end %>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>