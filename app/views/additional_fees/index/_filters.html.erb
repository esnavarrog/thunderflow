<div class="card">
  <div class="card-body">
    <%= form_with url: additional_fee_path, method: :get, data: { remote: true }, id: 'additional-fee-filter-form' do |f| %>
      <div class="row">
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <div class="form-group">
            <%= f.label :additional_type, AdditionalFee.human_attribute_name(:additional_type), class: 'form-label' %>
            <%= f.select :additional_type, options_for_select([]), {}, class: 'form-control' %>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <div class="form-group">
            <%= f.label :additional_fee, AdditionalFee.human_attribute_name(:additional_fee), class: 'form-label' %>
            <%= f.text_field :additional_fee, class: 'form-control' %>
          </div>
        </div>
        <div class="col-12 d-flex justify-content-end gap-2">
          <div class="col-md-3 col-lg-2">
            <div class="d-grid">
              <button type="button" class="btn btn-outline-primary clear-form" data-target="#additional-fee-filter-form">
                <%= I18n::FormHelpers.t(:submit, :clear) %>
              </button>
            </div>
          </div>
          <div class="col-md-3 col-lg-2">
            <div class="d-grid">
              <%= f.submit I18n::FormHelpers.t(:submit, :search), class: 'btn btn-primary' %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>