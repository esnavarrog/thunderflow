<%= form_with model: @additional_fee, id: 'commune-price-new-form', class: 'container bg-white border rounded p-4 shadow-sm', data: { remote: true } do |f| %>
  <div class="row mb-4">
    <div class="col-12">
      <h5 class="text-secondary mb-3">Configuración de Adicional</h5>
    </div>

    <%= f.hidden_field :additional_model, value: params[:additional_model] %>
    <%= f.hidden_field :additional_type, value: :minimum_requests if ['deal'].include?(params[:additional_model]) %>

    <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-3">
      <div class="form-group">
        <%= f.label :name_profile, AdditionalFee.human_attribute_name(:name_profile), class: 'form-label fw-semibold' %>
        <%= f.select :name_profile,
                     options_for_select(AdditionalFee.name_profiles.map { |k, _| [k.humanize, k] }, AdditionalFee.name_profiles.keys.first),
                     {},
                     class: 'form-select' %>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-3">
      <div class="form-group">
        <%= f.label :additional_fee, class: 'form-label fw-semibold' %>
        <div class="input-group">
          <span class="input-group-text">$</span>
          <%= f.number_field :additional_fee, class: 'form-control', placeholder: 'Ingrese monto' %>
        </div>
        <div class="invalid-feedback"></div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-3">
      <div class="form-group">
        <%= f.label :minimum_requests, class: 'form-label fw-semibold' %>
        <%= f.number_field :condition, class: 'form-control', placeholder: 'Ejem: 2' %>
        <div class="invalid-feedback"></div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12 col-sm-3">
      <div class="d-grid">
        <%= f.submit 'Guardar', class: 'btn btn-primary btn-lg'%>
      </div>
    </div>
  </div>
<% end %>