<!DOCTYPE html>
<html>
    <head>
        <title>Altyro Envíos</title>
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <%= csrf_meta_tags %>
        <%= csp_meta_tag %>

        <%= stylesheet_link_tag 'landpage', media: 'all', 'data-turbolinks-track': 'reload' %>
        <%= javascript_pack_tag 'landpage', 'data-turbolinks-track': 'reload' %>
        <link href="https://fonts.googleapis.com/css?family=Heebo:400,500,700|Fira+Sans:600" rel="stylesheet">
        <script src="https://unpkg.com/animejs@2.2.0/anime.min.js"></script>
        <script src="https://unpkg.com/scrollreveal@4.0.0/dist/scrollreveal.min.js"></script>

    </head>
    <body class="is-boxed has-animations">
        <%= yield %>
    </body>
</html>