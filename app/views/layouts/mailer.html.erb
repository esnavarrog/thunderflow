<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <%= stylesheet_link_tag 'mailer' %>
    <style type="text/css" data-premailer="ignore">
      /* Email styles need to be inline */
        @import url('https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700');


        body{
            font-family: Open Sans,Sans-Serif ;
            font-style: normal;
        }

        .text-center{
            text-align: center;
        }
        .text-right{
            text-align: right;
        }
        .text-left{
            text-align: left !important;
        }

        .btn {
            font-size: 14px;
            font-weight: 600;
            padding: 10px 24px;
            border-radius: 4px;
            transition: .5s;
            text-decoration: none;
        }

        .btn-primary{
            background-color: #00C8DC;
            color: white;
            padding: 15px;
            font-weight: 600;
            border: none;
            border-radius: 4px;
        }
        .btn-shadow-primary{
            background-color: #014A9B;
            color: white;
            padding: 15px;
            font-weight: 600;
            border: none;
            text-align: center;
            box-shadow: 0px 8px 16px rgba(99, 99, 99, 0.62);
        }

        .gradient-bg{
            background: rgba(99, 99, 99, 0.1);
            color: white;
        }

        .grey-bg{
            background: #FBFBFB;
            padding-top: 25px;
            padding-bottom: 25px;
            margin-top: 32px;
            font-size: 20px;
        }

        .grey-bg td{
            padding-top: 18px;
            padding-bottom: 18px;
        }

        .grey-bg a{
            color: black !important;
            text-decoration: none !important;
        }

        .title{
            margin-top: 32px;
            margin-bottom: 32px;
            padding-left: 40px;
            padding-right: 40px;
        }

        .pt-48{
            padding-top: 48px !important;
        }
        
        .pb-48{
            padding-bottom: 48px !important;
        }

        .pt-32{
            padding-top: 32px !important;
        }


        .pb-32{
            padding-bottom: 32px !important;
        }

        .pt-16{
            padding-top: 16px !important;
        }


        .pb-16{
            padding-bottom: 16px !important;
        }

        .top-gradient{
            display: block;
            height: 585px;
        }

        .bottom-gradient{
            padding-top: 50px;
            padding-bottom: 50px;
            display: block;
            color: #0C6170;
        }
        .bottom-gradient h4{
            font-size: 24px;
            font-weight: 400;
            margin-bottom: 40px;
        }
        .bottom-gradient td{
            padding: 0 40px;
        }

        .top-text{
            font-size: 18px;
            width: 540px;
            padding-bottom: 32px;
        }

        .bottom-text{
            font-size: 20px;
            padding-top: 162px;
            padding: 40px;
            text-align: center;
            color: #474747;
        }

        .image-logo{
            margin-top: 48px;
        }

        #footer, #footer-mobile{
            background: #00C8DC;
            color: white;
            height: 100px;
            font-size: 16px;
            border-top: solid 2px white;
        }

        #footer, #footer-mobile td{
            height: 100px;
        }
        #footer, #footer-mobile a{
            color:white !important;
            text-decoration: none !important;
        }
        #footer, #footer-mobile a:hover{
            color: white !important;
        }

        .icon{
        margin-right: 24px;

        }
        .blue-icon path{
            fill:#00C8DC;
        }

        .white-icon path{
            fill:white;
        }

        .pr-0{
            padding-right: 0;
        }

        .pl-0{
            padding-left: 0;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        table th{
            background-color: #0C6170;
            color:white;
        }

        table td{
            text-align: center;
        }
        table .d-table{
            display: table-cell;
        }

        table.content{
            width: 67%;
        }

        .w-20{
            width: 20%;
        }

        .w-25{
            width: 25%;
        }

        .w-5{
            width: 5%;
        }

        .img-mobile{
            display: none;
            margin-top: 35px;
        }

        #footer-mobile{
            display: none;
        }

        .circle-number{
            background: #A2A9AD;
            min-height: 24px;
            min-width: 24px;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            margin-right: 10px;
            font-size: 16px;
            color: white;
            text-align: center;
            padding: 5px;
        }

        .d-flex{
            display: flex !important;
        }

        .align-items-center{
            align-items: center !important;
        }

        .box-table{
            border: 1px solid #EBECED;
            font-size: 14px;
            font-weight: 700;
            border-radius: 8px;
            margin: 0 10%;
            background-color: #F1F8FF;
        }
        .box-table .h1{
            font-weight: 700;
            height:50px;
            display: flex;
            align-items: center;
            padding-left: 24px;
        }
        .box-table table{
            background-color: #fff;
        }

        .thead{
            background-color: #EBECED;
            display: table-row;
        }
        .thead th{
            padding: 14px;
        }
        .tbody{
            display: table-row;
        }
        .tbody th{
            padding: 14px;
        }
        .table-striped tbody:nth-of-type(odd) {
            background-color: white !important;
        }
        .table-striped tbody:nth-of-type(even) {
            background-color: #FAFCFF !important;
        }
        .table-striped tr:last-child th:first-child{
            border-radius: 0 0 0 8px;
        }
        .table-striped tr:last-child th:last-child{
            border-radius: 0 8px 0 0;
        }

        .text-with-number{
            display: flex;
            align-items: center;
        }

        .pr-30{
            padding-right: 30px;
        }

        .todo-logo-email{
            @media(max-width: 576px){
                padding-left: 80px;
            }
        }

        .td-contact-assignment{
            @media(max-width: 576px){
                margin-top: 60px;
            }
        }

        #footer, #footer-mobile a:-webkit-any-link{
            color:white !important;
        }

        .border{
            border: 1px solid #2b2b2b;
        }

      @media (max-width: 767.98px) {
        .img-desktop{
            display: none !important;
        }
        .img-mobile{
            display: block !important;
        }

        .title{
            font-size: 20px !important;
            padding-right: 50px !important;
            padding-left: 50px !important;
        }

        .top-text{
            font-size: 12px !important;
            width: 80%!important;
        }
        .bottom-text{
            font-size: 12px !important;
            padding-top: 100px !important;
            width: 80% !important;
            padding-left: 10% !important;
            text-align: center !important;
        }
          .grey-bg td{

              padding-top: 10px !important;
              padding-bottom: 10px !important;
              font-size: 12px !important;

          }

          .bottom-gradient{
              padding-bottom: 40px !important;
              padding-top: 40px!important;
          }

          .bottom-gradient h4 {
              font-size: 14px !important;
              width: 80% !important;
              padding-left: 10%!important;
          }

          #footer{
           display: none !important;
          }

          .pt-48 {
              padding-top: 0px !important;
          }

          .top-gradient{
              height: 460px!important;
          }

          .bottom-gradient td{
              width: 100% !important;
              padding-left: 0 !important;
              text-align: center;
          }

          .btn-primary{
              display: block !important;
              margin-left: 10%;
              margin-right: 10%;
          }

          .content{
              width: 80% !important;
          }
          #footer-mobile{
              display: block !important;
              font-size: 12px !important;
              height: 160px !important;
              padding-top: 30px !important;
              padding-bottom: 30px !important;
          }
          #footer-mobile td{
              height: auto !important;
              padding-top: 5px!important;
              padding-bottom: 5px!important;
          }
          #footer-mobile tr{
              display: block !important;
              margin-left: 40px !important;
          }
          .image-logo{
              margin-top: 30px !important;
          }
      }

    </style>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
