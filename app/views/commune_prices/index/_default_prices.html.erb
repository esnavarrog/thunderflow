<div class="card mb-4">
  <div class="card-header">
    <h6 class="mb-0">Precios por defecto</h6>
  </div>
  <div class="card-body">
    <div class="row">
      <% CommunePrice.name_profiles.keys.each do |profile| %>
        <div class="col-md-4">
          <% default_price = DefaultProfilePrice.find_by(name_profile: profile) %>
          <div class="form-group">
            <%= label_tag "default_price_#{profile}", "Precio por defecto #{profile.titleize}" %>
            <%= number_field_tag "default_price_#{profile}",
                                 default_price&.price,
                                 class: 'form-control save-default-price',
                                 data: {
                                   profile: profile
                                 }
            %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>