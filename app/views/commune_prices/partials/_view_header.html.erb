
<div class="border w-100 px-4 py-2 pv-4 shadow mb-4 d-flex flex-line justify-content-between align-items-center">
  <h5 class="m-0">
    <% unless action_name == 'index' %>
      <%= link_to :back, class: 'btn p-0 m-0' do %>
        <i class="bi bi-arrow-left-short fs-24"></i>
      <% end %>
    <% end %>

    <% if action_name == 'new' %>
      New
    <% end %>
  </h5>
</div>