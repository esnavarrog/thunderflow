
<%= render 'commune_prices/partials/view_header' %>

<div class="container d-flex flex-column gap-4">
  <%#= render 'branches/index/filters'%>
  <%= render 'commune_prices/index/default_price' %>
  <%= render 'commune_prices/index/default_prices' %>

  <div class="accordion" id="pricesAccordion">
    <!-- Sección Estándar -->
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEstandar">
          Tarifas Estándar
        </button>
      </h2>
      <div id="collapseEstandar" class="accordion-collapse collapse show" data-bs-parent="#pricesAccordion">
        <div class="accordion-body">
          <div class="d-flex justify-content-end mb-3">
            <%= link_to "Nueva Comuna Estándar", new_commune_price_path(name_profile: :estandar), class: 'btn btn-primary' %>
          </div>
          <%= render partial: 'commune_prices/index/table', locals: { commune_prices: @commune_prices.scope_estandar } %>
        </div>
      </div>
    </div>

    <!-- Sección Premium -->
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePremium">
          Tarifas Premium
        </button>
      </h2>
      <div id="collapsePremium" class="accordion-collapse collapse" data-bs-parent="#pricesAccordion">
        <div class="accordion-body">
          <div class="d-flex justify-content-end mb-3">
            <%= link_to "Nueva Comuna Premium", new_commune_price_path(name_profile: :premium), class: 'btn btn-primary' %>
          </div>
          <%= render partial: 'commune_prices/index/table', locals: { commune_prices: @commune_prices.scope_premium } %>
        </div>
      </div>
    </div>

    <!-- Sección Express -->
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExpress">
          Tarifas Express
        </button>
      </h2>
      <div id="collapseExpress" class="accordion-collapse collapse" data-bs-parent="#pricesAccordion">
        <div class="accordion-body">
          <div class="d-flex justify-content-end mb-3">
            <%= link_to "Nueva Comuna Express", new_commune_price_path(name_profile: :express), class: 'btn btn-primary' %>
          </div>
          <%= render partial: 'commune_prices/index/table', locals: { commune_prices: @commune_prices.scope_express } %>
        </div>
      </div>
    </div>
  </div>
</div>