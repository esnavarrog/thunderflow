<div class="btn-group dropstart">
    <div class="btn btn-link pe-0 ps-3 btn-icon" data-bs-toggle="dropdown" aria-expanded="false">
        <%= inline_svg_tag('icons/icon_ellipsis.svg', class:'icon-info')%>
    </div>
    <ul class="dropdown-menu shadow">
        <li>
            <%= link_to deal_path(deal), class:'dropdown-item text-success d-flex justify-content-between align-items-center' do %>
                <span>Ir</span> <i class="fa-regular fa-eye"></i>
            <% end %>
        </li>
        <li>
            <% if deal.pending? || deal.rejected? || deal.nothing? %>
                <%= link_to deal_payments_path(deal), method: :post, class:'dropdown-item text-success d-flex justify-content-between align-items-center' do %>
                    <span>Pagar</span> <i class="bi bi-credit-card"></i>
                <% end %>
            <% end %>
        </li>
        <% if current_user.admin? %>
            <li>
                <%= link_to payed_path(deal), class:'dropdown-item text-success d-flex justify-content-between align-items-center', remote:true do %>
                    <span>Ya pagado</span> <i class="bi bi-bag-check"></i>
                <% end %>
            </li>
            <li>
                <%= link_to edit_deal_path(deal), class:'dropdown-item text-success d-flex justify-content-between align-items-center' do %>
                    <span>Editar</span> <i class="bi bi-pencil-square"></i>
                <% end %>
            </li>
        <% end %>
        <% if [:payed, :rejected, :canceled].include?(deal.status_deal) || current_user.admin? %>
            <li>
                <%= link_to deal_path(deal), class:'dropdown-item text-danger d-flex justify-content-between align-items-center', method: :delete, remote:true do %>
                    <span>Eliminar</span> <i class="fa-solid fa-trash"></i>
                <% end %>
            </li>
        <% end %>
    </ul>
</div>