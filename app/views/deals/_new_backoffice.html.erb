<div class="container-fluid mt-3 table-deal-deliveries">
    <div class="rounded shadow-sm bg-white p-3 border border-primary">
        <div class="bg-light p-3 rounded my-3 text-secondary">
            Selecciona un cliente para mostrar las solicitudes entregadas, solo se mostrarán las solicitudes que estén pendientes de pago.
        </div>
        <%= render 'deals/components/select_company' %>

        <div class="d-flex justify-content-center align-items-center loader-tracking d-none p-3">
            <div class="spinner-border spinner-border-primary loading" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
        <div id="select_deliveries" class="mt-3">
        </div>
    </div>
</div>
