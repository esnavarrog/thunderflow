<%= render partial: 'partials/title_module', locals:{sector:"Editar cobro #{@deal.id}"} %>
<div class="container-fluid mt-3 table-deal-deliveries">
    <div class="rounded shadow-sm bg-white p-3 border border-primary">
        <h4 class="text-primary">
            Solicitudes de cliente <%= @deal.company.try(:name) %>
        </h4>
        <%= hidden_field_tag :delivery_ids, "#{@deal.deliveries.ids}" %>

        <div id="select_deliveries" class="mt-3">
            <div class="table-responsive max-scroll">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th class="th-date">Fecha</th>
                            <th>Direc. Retiro</th>
                            <th>Entrega</th>
                            <th>Repartidor</th>
                            <th>Estado</th>
                            <th>Precio</th>
                            <th>Pago repartidor</th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% @deal.deliveries.each do |delivery| %>
                            <tr>
                                <td>
                                    <%= delivery.id %>
                                </td>
                                <td>
                                    <%= format_date delivery.date_start %>
                                </td>
                                <td>
                                    <div class="top">
                                        <%= delivery.branch.commune %>
                                    </div>
                                    <div class="bottom">
                                        <%= delivery.branch.address_concat %>
                                    </div>
                                </td>
                                <td>
                                    <div class="top">
                                        <%= delivery.commune %>
                                    </div>
                                    <div class="bottom">
                                        <%= delivery.address_concat %>
                                    </div>
                                </td>
                                <td>
                                    <%= delivery.user_asign_id ? delivery.user_asign.try(:name) : 'Sin repartidor' %>
                                </td>
                                <td>
                                    <%= enum_i18n(Delivery, :statuses, delivery.status) %>
                                </td>
                                <td>
                                    <div class="form-group m-0">
                                        <input type="text" class="<%= delivery.price.present? ? "disabled" : "" %>" value="<%= delivery.price %>" name="" placeholder="--" id="price-<%= delivery.id %>">
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group m-0">
                                        <input type="text" class="<%= delivery.price_deliver.present? ? "disabled" : "" %>" value="<%= delivery.price_deliver %>" name="" placeholder="--" id="price-deliver-<%= delivery.id %>">
                                    </div>
                                </td>
                                <td>
                                    <div class="btn btn-outline-primary edit-prices" data-id="<%= delivery.id %>">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </div>
                                </td>
                                <td>
                                    <div class="btn btn-outline-primary save-prices" data-id="<%= delivery.id %>">
                                        <i class="fa-solid fa-floppy-disk"></i>
                                    </div>
                                </td>
                                <td>
                                    <div class="btn btn-outline-primary delete-delivery" data-id="<%= delivery.id %>">
                                        <i class="fa-solid fa-trash"></i>
                                    </div>
                                </td>
                            </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-end mt-2">
                
                <%= link_to "Calcular", get_result_prices_path(company_id:@deal.company_id, id:@deal.id, action_name:action_name), id:'calc-deliveries', class:'btn btn-primary', remote:true %>
            </div>
            <div id="calc-prices">
                <%= render partial: 'deals/form', locals:{ids: nil} %>
            </div>
        </div>
    </div>
</div>