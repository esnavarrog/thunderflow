<%= form_tag withdrawal_receipts_path, method: :get, remote: true, id: "search-form", class: 'mt-3 form-submit-on-change' do %>
  <%= hidden_field_tag :page, 1 %>
  <%= hidden_field_tag :format, 'js' %>
  <div class="row">
    <div class="form-group col-sm-12 col-md-6 col-lg-3 col-xl-2 form-calendar">
      <%= text_field_tag(
            :issued_at,
            nil,
            options = {
              placeholder: 'Fecha de Retiro',
              class: 'form-control datetimepicker-range' }) %>
    </div>

    <% if (policy(:application).backoffice?) && @companies_deliveries.present? %>
      <div class="form-group col-sm-12 col-md-6 col-lg-3 col-xl-2">
        <%= select_tag :company_id, options_from_collection_for_select(@companies_deliveries, :id, :name), { class: 'form-select js-basic-single', id: "company_id", prompt: 'Filtrar por Clientes' } %>
      </div>
    <% end %>
    <% if (policy(:application).backoffice?) %>
      <div class="form-group col-sm-12 col-md-6 col-lg-3 col-xl-2">
        <%= select_tag :user_id, options_from_collection_for_select(User.scope_staff, :id, :name), { class: 'form-select js-basic-single', id: "user_asign_id", prompt: 'Repartidor' } %>
      </div>
    <% end %>
    <div class="form-group col-sm-6 col-md-6 col-lg-3 col-xl-2">
      <div class="container-buttons-delivery filters">
        <%= link_to 'Limpiar', withdrawal_receipts_path, class: 'btn btn-outline-info p-3' %>
        <%= button_tag name: 'commit', type: :submit, class: 'btn btn-info p-3 filter-button-date' do %>
          <i class="bi bi-filter-circle-fill me-2"></i> Filtrar
        <% end %>
      </div>
    </div>
  </div>

<% end %>