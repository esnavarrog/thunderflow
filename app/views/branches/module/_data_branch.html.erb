<div class="container-fluid">
  <div class="">
    <div class="bg-white rounded-4 p-4 my-2">
      <div class="d-flex justify-content-between align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= @branch.id %>">
        <h4 class="title">
          Sucursal <%= @branch.name.present? ? @branch.name.try(:titleize) : 'Información Faltante' %>
        </h4>
        <h4>
          <i class="fa-solid fa-chevron-down"></i>
        </h4>
      </div>

      <div id="collapse-<%= @branch.id %>" class=" collapse show">
        <%= render 'branches/partials/data' %>
      </div>

      <div class="d-flex justify-content-between mt-3">
        <%= link_to edit_branch_path(@branch), class: 'btn btn-primary', remote: true do %>
          <i class="bi bi-pencil-square me-2"></i><span>Editar</span>
        <% end %>
      </div>
    </div>

  </div>
  <div class="">
    <%= render partial: 'deliveries/partials/filters', locals: { id_form: '_top' } %>
    <div id="container-deliveries">
      <div id="table-deliveries">
        <%= render 'deliveries/tables/table_deliveries' %>
      </div>
    </div>
  </div>
</div>


<div class="button-filter-mobile">
  <i class="fa-solid fa-filter"></i>
</div>
<div class="container-filters-mobile">
  <div class="d-flex justify-content-between">
    <h5>Filtrar</h5>
    <div class="btn btn-light text-info close-mobile"><i class="fa-solid fa-xmark"></i></div>
  </div>
  <%= render partial: 'deliveries/partials/filters', locals: { id_form: '_bottom' } %>
</div>

