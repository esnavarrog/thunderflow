wb = xlsx_package.workbook

wb.add_worksheet(name: "Pedidos") do |sheet|
    # Create the header row
    sheet.add_row ["Nº Solicitud", "Cod. Seguimiento", "Fecha Retiro", "Nombre Empresa", "Responsable", 
                    "Retiro", "Comuna", 
                    "Telefono", "Para", 
                    "Dirección Entrega", "Depto/Casa", "Comuna",
                    "Referencia", "Teléfono", "Observc.", "Precio Entrega", "Estado solicitud" ]
    # Create entries for each item
    @deliveries_xlsx.each do |delivery|
        sheet.add_row [ 
            delivery.id, 
            delivery.order_number,
            delivery.date_start,
            delivery.branch.company.name, 
            delivery.branch.responsible_name, 
            delivery.branch.address_concat,
            delivery.branch.commune, 
            delivery.branch.phone_number, 
            delivery.complete_name,
            delivery.address_concat,
            delivery.dpto,
            delivery.commune,
            delivery.reference,
            delivery.phone_number,
            delivery.description,
            delivery.price,
            delivery.status
        ]
    end
end