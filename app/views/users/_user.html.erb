

    <div class="">
        <div class="px-3 py-2 mb-1 bg-white shadow-sm rounded">
            <div class="d-flex justify-content-between align-items-center">
                <%= link_to user_path(user), class:'no-decoration' do %>
                    <div class="commune-list">
                        <%= user.email %>
                    </div>
                    
                <% end %>
                    
                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <div class="date-list">
                            <%= format_date user.created_at %>
                        </div>
                        <div class="date-list" id="role-data-<%= user.id %>">
                            <%= enum_i18n(User, :roles, user.role) %>
                        </div>
                        
                    </div>
                    <div class="btn-group dropstart">
                        <div class="btn btn-link pe-0 ps-3 btn-icon" data-bs-toggle="dropdown" aria-expanded="false">
                            <%= inline_svg_tag('icons/icon_ellipsis.svg', class:'icon-info')%>
                        </div>
                        <ul class="dropdown-menu shadow">
                            <li>
                                <%= link_to user_path(user), class:'dropdown-item text-success d-flex justify-content-between' do %>
                                    <span>Ver</span> <i class="bi bi-chevron-right"></i>
                                <% end %>
                            </li>
                            <% if user_signed_in? && current_user.admin? %>
                            <li>
                                <%= link_to edit_user_path(id:user), class:'dropdown-item text-success d-flex justify-content-between', remote:true do %>
                                    <span>Cambiar estado</span> <i class="bi bi-signpost-split"></i>
                                <% end %>
                            </li>
                            <% end %>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
