<div class="position-fixed top-0 end-0 ">
    <% if notice %>
      <div class="alert alert-success">
        <div class="d-flex justify-content-between">
          <div><%= notice %></div>
          <div class="close-alert ms-3"><i class="bi bi-x-circle"></i></div>
        </div>
      </div>
    <% end %>
    <% if alert %>
      <div class="alert alert-secondary">
        <div class="d-flex justify-content-between">
          <div><%= alert %></div>
          <div class="close-alert ms-3"><i class="bi bi-x-circle"></i></div>
        </div>
      </div>
    <% end %>

  </div>