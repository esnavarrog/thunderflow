
    <div class="mt-3">
        <div class="row table-responsive">
        <table class="table table-striped ">
            <tbody>
                <tr>
                    <td>Número de pago</td>
                    <td class="text-end"><%= @payment.deal_id %></td>
                </tr>
                <tr>
                    <td>Monto</td>
                    <td class="text-end"><%= number_to_currency(@payment.amount, precision: 0, unit: "$ ", delimiter: ".")%></td>           
                </tr>
                
                    <td>Código de autorización de Flow</td>
                    <td class="text-end"><%= @payment.flow_order %></td>       
                </tr>
                <%unless @payment.pay_date.nil?%>  
                    <tr>
                        <td>Fecha de transacción</td>
                        
                        <td class="text-end">
                            <%=format_date(@payment.pay_date)%>
                        </td>
                    </tr>
                <% end %>
                <%unless @payment.media.nil?%>  
                    <tr>
                        <td>Tipo de pago</td>
                        <td class="text-end">
                            <%= @payment.media.try(:titleize)%>    
                        </td>       
                    </tr> 
                <% end %>
                <tr>
                    <td>Estado Pago</td>
                    <td class="text-end">
                        <%= @payment.status ? enum_i18n(Payment, :statuses, @payment.status) : 'Sin registro' %>    
                    </td>       
                </tr> 
                
            </tbody>
        </table>         
        </div>
    </div>
    <div class="d-flex justify-content-end my-3">
        <%= link_to 'Vuelve a cobros', deals_path, class:'btn btn-primary' %>
    </div>
