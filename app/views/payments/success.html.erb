<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-8">

      <div class="card text-center shadow-sm">
        <div class="card-body p-5">

          <%# Icono de éxito (puedes usar una imagen o un SVG) %>
          <svg xmlns="http://www.w3.org/2000/svg" width="72" height="72" fill="currentColor" class="bi bi-check-circle-fill text-success mb-3" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
          </svg>

          <h1 class="card-title">¡Pago Exitoso!</h1>
          <p class="lead">Gracias por tu compra. Hemos recibido tu pago y te hemos enviado un recibo a tu correo electrónico.</p>
          <hr>

          <div class="text-start mt-4">
            <h5 class="mb-3">Resumen de la Transacción</h5>

            <p>
              <strong>ID de Transacción:</strong>
              <span><%= @payment.deal_id %></span>
            </p>

            <p>
              <strong>Fecha del Pago:</strong>
              <%# Usamos 'l' (alias de localize) para formatear la fecha de forma legible %>
              <span><%= l(@payment.created_at, format: :long) %></span>
            </p>

            <% if @payment.description.present? %>
              <p>
                <strong>Concepto:</strong>
                <span><%= @payment.description %></span>
              </p>
            <% end %>

            <p class="fw-bold">
              <strong>Monto Pagado:</strong>
              <%# number_to_currency formatea el monto con el símbolo de moneda correcto %>
              <span class="text-success fs-5"><%= number_to_currency(@payment.amount, unit: 'USD', precision: 2) %></span>
              <%# Cambia 'USD' por la moneda que uses, o usa @payment.currency si lo tienes guardado %>
            </p>
          </div>

          <div class="mt-4">
            <%= link_to 'Volver al inicio', root_path, class: 'btn btn-primary' %>
            <%# Si tienes una URL para un recibo más detallado, puedes añadirla aquí %>

          </div>

        </div>
      </div>

    </div>
  </div>
</div>