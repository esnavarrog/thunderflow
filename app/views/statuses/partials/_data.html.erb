<div class="d-flex justify-content-center">
    <%= image_tag @status.image_url, class:'image-status' if @status.image.present? %>
</div>
<div class="mt-3">
    
    <div class="status-list status-list-<%= @status.status %>">
        <span><%= enum_i18n(Status, :statuses, @status.status) %></span><div></div>
    </div>
    <div class="text-info">
        <%= format_date_human @status.created_at %>
    </div>
    <div class="text-secondary">
        <%= format_time @status.created_at %> hrs.
    </div>
    <% if @status.receiver_name.present? %>
        <div class="text-secondary">
            Recibió <%= @status.receiver_name.titleize %>
        </div>
    <% end %>
    <% if @status.receiver_rut.present? %>
        <div class="text-secondary">
            Rut: <%= @status.receiver_rut %>
        </div>
    <% end %>
    <% if @status.receiver_phone.present? %>
        <div class="">
            <%= link_to "tel:+56#{@status.receiver_phone}", class:'btn btn-sm btn-primary shadow-sm' do %>
                <i class="fa-solid fa-phone"></i> <%= @status.receiver_phone %>
            <% end %>
        </div>
    <% end %>
    <% if @status.description.present? %>
        <div class="text-primary">
            Observaciones: <%= @status.description %>
        </div>
    <% end %>
</div>
