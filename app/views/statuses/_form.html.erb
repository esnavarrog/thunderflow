    <div class="modal-body">

        <%= form_with(model:[@status], class:'', id:'form-change-status', data:{remote:true}) do |f| %>
            <%= hidden_field_tag :delivery_id, '' %>
            <h5 class="title-names text-success"><span id="count-massive" class="text-secondary"></span> Seleccionados: <span id="id-delivery"></span></h5>

            <div class="form-group">
                <% @statuses.each do |status| %>
                    <% if ['returned', 'preparing'].include?(status[0]) %>
                        <% if current_user.admin? %>
                            <% unless ['nothing'].include?(status[0]) %>
                                <div class="form-check form-check-big form-switch d-flex justify-content-between align-items-center mb-2">
                                    <label for="status_<%= status[0] %>" class="form-check-label"><%= enum_i18n(Delivery, :statuses, status[0]) %></label>
                                    <%= f.radio_button :status, status[0], id:"status_#{status[0]}", checked: status[0] == (@delivery.present? ? @delivery.status : ''), class:'form-check-input' %>
                                </div>
                            <% end %>
                        <% end %>
                    <% else %>
                        <% if !['nothing'].include?(status[0]) %>
                            <div class="form-check form-check-big form-switch d-flex justify-content-between align-items-center mb-2">
                                <label for="status_<%= status[0] %>" class="form-check-label"><%= enum_i18n(Delivery, :statuses, status[0]) %></label>
                                <%= f.radio_button :status, status[0], id:"status_#{status[0]}", checked: status[0] == (@delivery.present? ? @delivery.status : ''), class:'form-check-input' %>
                            </div>
                        <% end %>
                    <% end %>
                    
                <% end %>
            </div>
            
            <div class="form-group d-none receive-form deliver">
                <%= f.label :receiver_name, 'Nombre quien entrega/recibe' %>
                <%= f.text_field :receiver_name, class:'form-control'  %>
            </div>
            <div class="form-group d-none receive-form deliver">
                <%= f.label :receiver_phone, 'Teléfono quien entrega/recibe' %>
                <%= f.text_field :receiver_phone, class:'form-control', placeholder:'Teléfono...'  %>
            </div>
            <div class="form-group d-none receive-form deliver">
                <%= f.label :receiver_rut, 'Rut quien entrega/recibe' %>
                <%= f.text_field :receiver_rut, class:'form-control rut-input', placeholder:'Rut...'  %>
            </div>
            <div class="form-group d-none receive-form">
                <%= f.label :image, 'Imagen' %>
                <%= f.file_field :image, class:'form-control' %>
            </div>
            <div class="form-group d-none receive-form">
                <%= f.label :description, 'Observaciones (opcional)' %>
                <%= f.text_area :description, class:'form-control'  %>
            </div>
            <% if current_user.admin? %>
                <div class="row">
                    <div class="form-group col-sm-12 col-md-6">
                        <%= f.label :price, 'Precio Total despacho' %>
                        <%= text_field_tag :price, {}, class:'form-control', placeholder:'Ingresa valor...' %>
                        <div class="error"></div>
                    </div>
                    <div class="form-group col-sm-12 col-md-6">
                        <%= f.label :price_deliver, 'Pago Repartidor' %>
                        <%= text_field_tag :price_deliver, {}, class:'form-control', placeholder:'Ingresa valor...' %>
                        <div class="error"></div>
                    </div>
                </div>
            <% end %>
            <div class="d-flex justify-content-end">
                <div id="press-submit" data-submit="#submit-status" class="btn btn-primary mt-3">
                    <div class="spinner-border text-light loading d-none mr-2" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <span class="change-loading">Cambiar</span>
                </div>
                <%= f.submit 'Cambiar Estado', class:'btn btn-primary d-none mt-3', id:'submit-status' %>
            </div>
            
        <%end%>
    </div>
