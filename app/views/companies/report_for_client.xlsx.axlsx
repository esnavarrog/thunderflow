wb = xlsx_package.workbook

wb.add_worksheet(name: "Solicitudes") do |sheet|
    # Create the header row
    sheet.add_row ["Nº Solicitud", "Cod. Seguimiento", "Fecha Retiro", "Fecha de Entrega", "Nombre Empresa", 
                    "Nombre sucursal","Retiro sucursal", "Comuna", "Para", "Dirección Entrega", "Depto/Casa", "Comuna",
                    "Referencia", "Teléfono", "Observc.", "Precio Entrega" ]
    # Create entries for each item
    @deliveries.each do |delivery|
        sheet.add_row [
            delivery.id,
            delivery.order_number,
            delivery.date_start,
            delivery.date_deliver_at,
            delivery.branch.company.name,
            delivery.branch.name,
            delivery.branch.address_concat,
            delivery.branch.commune,
            delivery.complete_name,
            delivery.address_concat,
            delivery.dpto,
            delivery.commune,
            delivery.reference,
            delivery.phone_number,
            delivery.description,
            delivery.price
        ]
    end
end