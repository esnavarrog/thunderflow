
<div class="border-bottom py-3">
    <h5>Información Empresa</h5>
    <div id="status" class="badge rounded-pill bg-<%= @company.klass_statuses %> mb-2">
        <%= enum_i18n(Company, :statuses, @company.status) %>
    </div>
    <div class="text-secondary">
        <%= @company.fantasy_name.try(:titleize) %>
    </div>
    <% if @company.name.present? %>
    <div class="text-secondary">
        <%= @company.name.try(:titleize) %>
    </div>
    <% end %>
    <div class="text-info">
        <%= @company.rut %>
    </div>
</div>

<div class="border-bottom py-3">
    <h5>Datos Empresa</h5>
    <div class="">
        <div class="text-info">Dirección:</div>
        <%= "#{@company.address_concat}" %>
    </div>

    <div class="">
        <div class="text-info">Referencias:</div>
        <%= @company.reference %>
    </div>

    <div class="">
        <div class="text-info">Responsable:</div>
        <%= @company.responsible_name %>
    </div>

    <% if @company.time_open.present? %>
        <div class="">
            <div class="text-info">Horarios Cliente:</div>
            Apertura <%= format_time @company.time_open %>
        </div>
    <% end %>

    <% if @company.time_close.present? %>
        <div class="">
            Cierre <%= format_time @company.time_close %>
        </div>
    <% end %>

    <div class="d-flex flex-column">
        <% if @company.email.present? %>
            <%= link_to "mailto:#{@company.email}", class:'btn btn-sm btn-primary mt-2' do %>
                <i class="fa-sharp fa-solid fa-envelope"></i> <%= @company.email %>
            <% end %>
        <% end %>
        <% if @company.phone_number.present? %>
            <%= link_to "tel:+56#{@company.phone_number.gsub(/\s+/, " ")}", class:'btn btn-sm btn-primary mt-2' do %>
                <i class="fa-solid fa-phone"></i> <%= @company.phone_number %>
            <% end %>
        <% end %>
        <% if @company.web_address.present? %>
            <%= link_to @company.web_address =~ URI::regexp ? @company.web_address : '#', class:'btn btn-sm btn-link mt-2' do %>
                <i class="fa-solid fa-earth-americas"></i> <%= @company.web_address %>
            <% end %>
        <% end %>
    </div>
</div>