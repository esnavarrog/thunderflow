<div class="border bg-white rounded p-3 my-3">
    <div type="button" class="d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#collapse-<%= @company.id %>">
        <h4 class="text-truncate text-secondary"><%= @company.name.try(:titleize) %></h4>
        <h4>
            <i class="fa-solid fa-chevron-down"></i>
        </h4>
    </div>
    <div id="collapse-<%= @company.id %>"  class="collapse show">
        <%= render 'companies/partials/data' %>
    </div>
    <div class="d-flex justify-content-end mt-3">
        <%= link_to edit_company_path(@company), class:'btn btn-primary', remote:true do %>
            <i class="bi bi-pencil-square me-2"></i><span>Editar</span>
        <% end %>
    </div>
</div>