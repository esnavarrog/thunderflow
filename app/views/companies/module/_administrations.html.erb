<div class="tab-pane fade" id="pills-admins" role="tabpanel" aria-labelledby="pills-admins-tab" tabindex="0">
    <div class="container bg-light border border-light rounded p-3 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="text-secondary m-0">Administradores</h5>
            <%= link_to new_company_user_access_path(@company), class:'btn btn-secondary', remote:true do %>
                <i class="fa-solid fa-plus"></i>
            <% end %>
        </div>
        <div id="administrators">
            <%= render @user_accesses %>
        </div>
    </div>
</div>
