
<div class="container">
    <div id="companies" class="row">
        <% @branches.each do |branch| %>
            <div class="col-sm-12 col-md-6 col-lg-4 py-2">
                <div class="card shadow-sm position-relative">
                    <div class="card-header" style="height: 90px;" type="button">
                        <div class="d-flex justify-content-between align-items-center ">
                            <h1 class="text-truncate">
                                <%= branch.name.try(:titleize) %>
                            </h1>
                        </div>
                        <div class="card-sub">
                            <%= branch.address_concat %>
                        </div>
                        <div class="card-sub text-success">
                            Solicitudes <%= branch.deliveries.count %>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="d-flex justify-content-between">
                            <%= link_to branch_path(branch), class:'btn btn-outline-primary' do %>
                                <i class="bi bi-eye"></i>
                            <% end %>
                            <%= link_to 'Agendar retiro', new_branch_delivery_path(branch), class:'btn btn-outline-primary', remote:true %>
                        </div>
                    </div>
                </div>
            </div>
        <% end %>
    </div>
</div>
