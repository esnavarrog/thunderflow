<div class="tab-pane fade" id="pills-integrations" role="tabpanel" aria-labelledby="pills-integrations-tab" tabindex="0">
  <div class="container bg-light border border-light rounded p-3 mb-3 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="text-secondary m-0">Integraciones</h5>
      <%= link_to new_company_integration_path(@company), class:'btn btn-secondary', remote:true do %>
        <i class="fa-solid fa-plus"></i>
      <% end %>
    </div>
    <div id="integrations">
      <%= render @integrations %>
    </div>
  </div>
</div>