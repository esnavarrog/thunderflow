<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>Dashboard</h1>
        <div class="dashboard-controls">
            <% if current_user.admin? %>
                <%= link_to report_form_path, remote: true, class: 'dashboard-btn btn-primary' do %>
                    <i class="bi bi-bar-chart-fill"></i> Reportes
                <% end %>
                <%= link_to open_modal_ids_path, remote: true, class: 'dashboard-btn btn-outline' do %>
                    <i class="bi bi-download"></i> Descargar por IDs
                <% end %>
                <% if current_user.email == 'esteban.navarro@despachospymes.cl' %>
                  <%= link_to export_deliveries_by_month_and_company_path(year: params[:year], month: params[:month], format: :xlsx), class: 'dashboard-btn btn-outline' do %>
                      <i class="bi bi-file-earmark-excel-fill"></i> Exportar entregas
                  <% end %>
                <% end %>

            <% end %>
        </div>
    </div>

    <div class="filter-section">
        <%= form_with(url: metrics_path, method: :get, data: {remote: true}, class: 'd-flex gap-3 w-100', local: true) do |f| %>
            <div class="flex-grow-1">
                <%= f.select :month,
                    I18n.t('date.month_names').compact.each_with_index.map { |m, i| [m.capitalize, i+1] },
                    { include_blank: 'Mes (actual: ' + I18n.l(Date.current, format: '%B') + ')',
                      selected: params[:month] || Date.current.month },
                    class: 'filter-input form-select' %>
            </div>
            <div class="flex-grow-1">
                <%= f.select :year,
                    (Date.current.year - 3..Date.current.year).to_a.reverse,
                    { include_blank: 'Año (actual: ' + Date.current.year.to_s + ')',
                      selected: params[:year] || 2025 },
                    class: 'filter-input form-select' %>
            </div>
            <%= f.button type: 'submit', class: 'dashboard-btn btn-primary' do %>
                <i class="bi bi-funnel"></i> Filtrar
            <% end %>
        <% end %>
    </div>

    <div id="metrics"></div>

    <section id="charts-welcome" class="row">
    </section>

  <section class="row mb-3">
    <div class="col-sm-12 col-md-6 mb-3">
      <div class="h-100 bg-white rounded-4 p-2 shadow-sm">
        <div class="p-2 mb-2 text-info header-count-deliveries">
          <div>Conteo de solicitudes asignadas</div>
          <small class="text-success">Solo muestra las solicitudes que tengan el estado "Asignado".  (Solo repartidor con solicitud asignada)</small>
        </div>
        <div class="d-flex justify-content-between text-secondary p-2 bg-light rounded-top">
          <span>Repartidor</span>
          <span>Asignaciones</span>
        </div>
        <div class="mxh-300">
          <% @dealers.each do |dealer| %>
            <div class="d-flex justify-content-between mb-2 p-2 border-top bg-white">
              <span class="text-secondary"><%= link_to dealer.name || dealer.email, profile_path(dealer), class:'link-profile-user' %></span>
              <span><%= dealer.deliveries_asigned_count %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-sm-12 col-md-6 mb-3">
      <div class="h-100 bg-white rounded-4 p-2 shadow-sm">
        <div class="p-2 mb-2 text-info header-count-deliveries">
          <div>Conteo de solicitudes por entregar</div>
          <small class="text-success">Muestra las solicitudes que aún no se entregan o devuelven. (Solo repartidor con solicitud asignada)</small>
        </div>
        <div class="d-flex justify-content-between text-secondary p-2 bg-light rounded-top">
          <span>Repartidor</span>
          <span>Asignaciones</span>
        </div>
        <div class="mxh-300">
          <% @dealers_for_deliver.each do |dealer| %>
            <div class="d-flex justify-content-between mb-2 p-2 border-top bg-white">
              <span class="text-secondary"><%= link_to dealer.name || dealer.email, profile_path(dealer), class:'link-profile-user' %></span>
              <span><%= dealer.deliveries_asigned_count %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>
</div>
