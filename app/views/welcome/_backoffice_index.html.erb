<div class="container mt-3">
    <section class="row mb-3">
        <!-- report of deliveries -->
        <% if current_user.admin? %>
        <div class="col-md-3 my-2">
            <%= link_to report_form_path, remote: true, class: 'text-decoration-none' do %>
              <div class="card text-center shadow-sm h-100">
                  <div class="card-body">
                      <i class="bi bi-bar-chart-fill text-primary" style="font-size: 2rem;"></i>
                      <div class="mt-2 text-primary">Reportes</div>
                  </div>
              </div>
            <% end %>
        </div>
        <div class="col-md-3 my-2">
            <%= link_to open_modal_ids_path, remote: true, class: 'text-decoration-none' do %>
              <div class="card text-center shadow-sm h-100">
                  <div class="card-body">
                      <i class="bi bi-download text-primary" style="font-size: 2rem;"></i>
                      <div class="mt-2 text-primary">Descargar por IDs</div>
                  </div>
              </div>
            <% end %>
        </div>
        <div class="col-md-3 my-2">
            <%= link_to export_deliveries_by_month_and_company_path(year: params[:year], month: params[:month], format: :xlsx), class: 'text-decoration-none' do %>
              <div class="card text-center shadow-sm h-100">
                  <div class="card-body">
                      <i class="bi bi-file-earmark-excel-fill text-success" style="font-size: 2rem;"></i>
                      <div class="mt-2 text-success">Exportar entregas por mes/cliente</div>
                  </div>
              </div>
            <% end %>
        </div>
        <% end %>
    </section>

    <!-- Filtros de mes y año con mejor UX/UI -->
    <div class="row mb-4 align-items-end">
      <div class="col-md-3 col-sm-6 mb-2">
        <label for="month-select" class="form-label fw-bold">Mes</label>
        <%= form_with(url: metrics_path, method: :get, data:{remote:true}, html: {class:'d-flex gap-2 align-items-end'}, local: true) do |f| %>
          <%= f.select :month, I18n.t('date.month_names').compact.each_with_index.map { |m, i| [m.capitalize, i+1] }, { include_blank: 'Todos los meses', selected: params[:month] || Date.current.month }, class: 'form-select', id: 'month-select' %>
      </div>
      <div class="col-md-3 col-sm-6 mb-2">
        <label for="year-select" class="form-label fw-bold">Año</label>
        <%= f.select :year, (Date.current.year - 3..Date.current.year).to_a.reverse, { include_blank: 'Todos los años', selected: params[:year] || Date.current.year }, class: 'form-select', id: 'year-select' %>
      </div>
      <div class="col-md-2 col-sm-12 mb-2">
        <%= f.button type: 'submit', class: 'btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2' do %>
          <i class="bi bi-funnel"></i> Filtrar
        <% end %>
      </div>
        <% end %>
    </div>

    <div id="metrics"></div>

    <section id="charts-welcome" class="row mb-3"></section>

    <section class="row mb-3">
        <div class="col-sm-12 col-md-6 mb-3">
            <div class="h-100 bg-white rounded-4 p-2 shadow-sm">
                <div class="p-2 mb-2 text-info header-count-deliveries">
                    <div>Conteo de solicitudes asignadas</div>
                    <small class="text-success">Solo muestra las solicitudes que tengan el estado "Asignado".  (Solo repartidor con solicitud asignada)</small>
                </div>
                <div class="d-flex justify-content-between text-secondary p-2 bg-light rounded-top">
                    <span>Repartidor</span>
                    <span>Asignaciones</span>
                </div>
                <div class="mxh-300">
                    <% @dealers.each do |dealer| %>
                        <div class="d-flex justify-content-between mb-2 p-2 border-top bg-white">
                            <span class="text-secondary"><%= link_to dealer.name || dealer.email, profile_path(dealer), class:'link-profile-user' %></span>
                            <span><%= dealer.deliveries_asigned_count %></span>
                        </div>
                    <% end %>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-6 mb-3">
            <div class="h-100 bg-white rounded-4 p-2 shadow-sm">
                <div class="p-2 mb-2 text-info header-count-deliveries">
                    <div>Conteo de solicitudes por entregar</div>
                    <small class="text-success">Muestra las solicitudes que aún no se entregan o devuelven. (Solo repartidor con solicitud asignada)</small>
                </div>
                <div class="d-flex justify-content-between text-secondary p-2 bg-light rounded-top">
                    <span>Repartidor</span>
                    <span>Asignaciones</span>
                </div>
                <div class="mxh-300">
                    <% @dealers_for_deliver.each do |dealer| %>
                        <div class="d-flex justify-content-between mb-2 p-2 border-top bg-white">
                            <span class="text-secondary"><%= link_to dealer.name || dealer.email, profile_path(dealer), class:'link-profile-user' %></span>
                            <span><%= dealer.deliveries_asigned_count %></span>
                        </div>
                    <% end %>
                </div>
            </div>
        </div>
    </section>

</div>