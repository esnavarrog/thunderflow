wb = xlsx_package.workbook
wb.add_worksheet(name: "Deliveries por mes y cliente") do |sheet|
  # Título
  sheet.add_row(["Solicitudes #{@year}"], style: wb.styles.add_style(sz: 14, b: true))
  sheet.add_row([]) # Fila vacía
  # Encabezado: Empresa, enero, febrero, ...
  sheet.add_row(["Empresa"] + @meses.map(&:capitalize))
  @excel_data.each do |row|
    sheet.add_row row
  end
end
