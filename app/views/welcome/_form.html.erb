<%= form_with(url: report_for_pay_path(format: :xlsx), method: :get) do |f| %>
    <div class="d-flex">
        <div class="form-group col-sm-12">
            <%= label_tag :status, "Selecciona un Estado..." %>
            <%= select_tag :status, options_for_select(enum_options_for_select(Delivery, :statuses)), class:'form-control', id:'status-select' %>
        </div>
    </div>
    <div class="form-group form-calendar">
        <%= text_field_tag(
            :date_start,
            {},
            options = {
                placeholder: 'Fecha Entrada',
                class:'form-control datetimepicker'} ) %>
    </div>
    <div class="form-group form-calendar">
        <%= text_field_tag(
            :date_end,
            {},
            options = {
                placeholder: 'Fecha Final',
                class:'form-control datetimepicker'} ) %>
    </div>
    

    <%= submit_tag 'Descargar', class:'btn btn-primary' %>
<% end %>