<% if @deliveries.present? %>
<div class="mt-3">
    <h5>Solicitudes</h5>
    <div id="deliveries-index">
        <%= render @deliveries %>
    </div>
    <div class="container">
        <div class="paginate-deliveries paginates paginates-index">
            <%= paginate @deliveries, remote: true %>
        </div>
    </div>
</div>

<% else %>
    <div id="deliveries" class="d-flex justify-content-center align-items-center p-3-1 my-3 rounded border border-primary bg-white">
        <h4 class="m-0">Aún no tienes solicitudes, agrega <span><%= link_to 'aquí', new_branch_delivery_path(@branch), data:{ bs_toggle:"modal", bs_target:"#modal"}, remote:true %></span></h4>
    </div>
<% end %>