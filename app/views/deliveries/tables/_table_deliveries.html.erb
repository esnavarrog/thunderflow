<% if current_user.delivery_table? && policy(:application).administration? %>

  <div class="rounded rounded-4 overflow-auto p-2 bg-white">
    <% if policy(:application).administration? %>
    <div class="d-flex justify-content-between align-items-center">
      <% if policy(:application).backoffice? %>
      <div class="bg-secondary text-white rounded-4 py-1 px-2">
        <%= "#{@deliveries.total_count} encontrados" %>
      </div>
      <% end %>
      <div class="d-flex justify-content-end gap-2 mb-3">
        <% if policy(:application).backoffice? || policy(:application).client? %>
          <input type="number" id="table-limit" class="form-control w-80px" value="<%= params[:limit] || 20 %>" placeholder="Limite de items">
        <% end %>
        <div class="btn-group">
          <div class="btn btn-outline-info change-show-delivery <%= 'active' if current_user.user_setting.list? %>" data-deliveries="list">
            <i class="bi bi-list-ul"></i>
          </div>
          <div class="btn btn-outline-info change-show-delivery <%= 'active' if current_user.user_setting.card? %>" data-deliveries="card">
            <i class="bi bi-grid"></i>
          </div>
        </div>
      </div>
    </div>
    <% end %>
    <div class="table-responsive">
      <%= render 'deliveries/tables/table' %>
    </div>
    <% if ['branches'].include?(controller_name) %>
      <div class="paginate-deliveries paginates paginates-index">
        <%= paginate @deliveries, remote: true %>
      </div>
    <% end %>
  </div>

<% else %>

  <% if @deliveries.present? %>
    <div class="p-2">
      <% if policy(:application).administration? %>
        <div class="d-flex <%= ['branches'].include?(controller_name) ? 'justify-content-between' : 'justify-content-end' %> align-items-center gap-2 mb-3">
          <% if controller_name == 'branches' %>
            <h5>Solicitudes</h5>
          <% end %>
          <% if policy(:application).backoffice? %>
            <div class="bg-secondary text-white rounded-4 py-1 px-2">
              <%= "#{@deliveries.total_count} encontrados" %>
            </div>
          <% end %>

          <% if policy(:application).backoffice? || policy(:application).client? %>
            <input type="number" id="table-limit" class="form-control w-80px" value="<%= params[:limit] || 20 %>" placeholder="Limite de items">
          <% end %>

          <div class="btn-group">
            <div class="btn btn-outline-info change-show-delivery <%= 'active' if current_user.user_setting.list? %>" data-deliveries="list">
              <i class="bi bi-list-ul"></i>
            </div>
            <div class="btn btn-outline-info change-show-delivery <%= 'active' if current_user.user_setting.card? %>" data-deliveries="card">
              <i class="bi bi-grid"></i>
            </div>
          </div>
        </div>
      <% end %>
      <div class="mt-3">
        <div id="deliveries-index" class=" mt-3">
          <%= render @deliveries %>
        </div>
        <% if ['branches'].include?(controller_name) %>
          <div class="paginate-deliveries paginates paginates-index d-flex justify-content-end">
            <%= paginate @deliveries, remote: true %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div id="deliveries" class="d-flex justify-content-center align-items-center p-3-1 my-3 rounded border border-primary bg-white">
      <h4 class="m-0">Aún no tienes solicitudes, <span><%= link_to 'Agenda retiro', get_deliver_path(company_id: current_company), remote:true %></span></h4>
    </div>
  <% end %>

<% end %>