$("#data-branch").html("<%= j render 'deliveries/form' %>");


$(".datetimepicker").flatpickr({
    dateFormat: "d-m-Y",
    minDate: "today",
    locale: "es"
});
$(".datetimepicker-time").flatpickr({
    dateFormat: "H:i",
    noCalendar: true,
    locale: "es",
    time_24hr: true,
    enableTime: true
});

launchmap(<%= @delivery.latitude.present? ? @delivery.latitude : false %>, <%= @delivery.longitude.present? ? @delivery.longitude : false %>, 'delivery_');
